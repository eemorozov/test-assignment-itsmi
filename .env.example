# Application Port and Environment
PORT=3000
NODE_ENV=development

# Option 1: Local run with Open Server Panel 5.x PostgreSQL
# (Default OSPanel 5.x user: postgres, empty password, port: 5432)
DATABASE_URL="postgresql://postgres@127.0.0.1:5432/morozov_cv?schema=public"

# Option 2: If postgres password is set (e.g. postgres:postgres)
# DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/morozov_cv?schema=public"

# Option 3: Docker Compose (configured automatically in docker-compose.yml)
# DATABASE_URL="postgresql://postgres:postgres@postgres:5432/morozov_cv?schema=public"
