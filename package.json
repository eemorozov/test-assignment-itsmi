{
  "name": "morozov-cv-graphql-api",
  "version": "1.0.0",
  "description": "GraphQL Digital Business Card API for Evgeny Morozov (Senior Frontend Developer) built with NestJS, Apollo, Prisma, and PostgreSQL",
  "author": "Evgeny Morozov",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "prisma generate && nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "ts-node prisma/seed.ts",
    "setup:local": "prisma generate && prisma db push && ts-node prisma/seed.ts"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@apollo/server": "4.11.3",
    "@nestjs/apollo": "12.2.2",
    "@nestjs/common": "10.4.15",
    "@nestjs/core": "10.4.15",
    "@nestjs/graphql": "12.2.2",
    "@nestjs/platform-express": "10.4.15",
    "@prisma/client": "5.22.0",
    "dataloader": "2.2.3",
    "dotenv": "16.4.7",
    "graphql": "16.10.0",
    "prisma": "5.22.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "10.4.9",
    "@nestjs/schematics": "10.2.3",
    "@types/express": "4.17.25",
    "@types/node": "22.10.7",
    "rimraf": "6.0.1",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.7.3"
  }
}
